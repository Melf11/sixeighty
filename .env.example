# Vorlage für .env (lokale Entwicklung). Kopieren mit:  cp .env.example .env

# Begleitforum. Ohne Angabe zeigt die App auf die öffentliche Instanz —
# im Dev-Betrieb ist das selten gewollt. Lokales Forum starten:
#   cd ../forum-680 && docker compose -f docker-compose.dev.yml up -d
NUXT_PUBLIC_FORUM_URL=http://localhost:8888
